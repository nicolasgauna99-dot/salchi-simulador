<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Personalizá tu collar | Salchi & Co.</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 20px;
      font-family: Arial, sans-serif;
      background: #fff4fa;
      color: #3d2635;
    }

    .contenedor {
      max-width: 900px;
      margin: auto;
      background: white;
      padding: 25px;
      border-radius: 25px;
      box-shadow: 0 8px 30px #d9a9c533;
    }

    h1 {
      text-align: center;
      color: #d94f91;
      margin-bottom: 5px;
    }

    .subtitulo {
      text-align: center;
      margin-bottom: 25px;
    }

    .principal {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      align-items: center;
    }

    .vista {
      background: #fff9fc;
      border-radius: 20px;
      padding: 20px;
      text-align: center;
      min-height: 300px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .collar {
      width: 100%;
      height: 100px;
      border-radius: 55px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 15px;
      margin: 20px auto;
      box-shadow: inset 0 -8px 0 #00000018, 0 8px 15px #00000018;
      transition: background 0.2s;
    }

    .letra {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: white;
      color: #222;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 25px;
      font-weight: bold;
      box-shadow: 0 3px 5px #00000025;
      text-transform: uppercase;
    }

    .controles {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    label {
      font-weight: bold;
      margin-bottom: 5px;
      display: block;
    }

    input, select, button {
      width: 100%;
      padding: 12px;
      border-radius: 12px;
      border: 1px solid #e1bfd2;
      font-size: 16px;
    }

    input[type="color"] {
      height: 48px;
      padding: 4px;
      cursor: pointer;
    }

    button {
      background: #d94f91;
      color: white;
      border: none;
      font-weight: bold;
      cursor: pointer;
      margin-top: 10px;
    }

    button:hover {
      background: #b93675;
    }

    .nota {
      font-size: 13px;
      color: #806575;
      text-align: center;
      margin-top: 20px;
    }

    @media (max-width: 700px) {
      .principal {
        grid-template-columns: 1fr;
      }

      .contenedor {
        padding: 18px;
      }
    }
  </style>
</head>

<body>
  <main class="contenedor">
    <h1>Diseñá tu collar 🐾</h1>
    <p class="subtitulo">
      Elegí el nombre y los colores de tu mascota en tiempo real.
    </p>

    <section class="principal">
      <div class="vista">
        <h2 id="tituloVista">Collar de tu mascota</h2>

        <div id="collar" class="collar">
          <span class="letra">N</span>
          <span class="letra">O</span>
          <span class="letra">M</span>
          <span class="letra">B</span>
          <span class="letra">R</span>
          <span class="letra">E</span>
        </div>

        <p id="resumen">Nombre: NOMBRE</p>
      </div>

      <div class="controles">
        <div>
          <label for="nombre">Nombre de la mascota</label>
          <input
            type="text"
            id="nombre"
            maxlength="10"
            value="NOMBRE"
            placeholder="Ejemplo: BROWN"
          >
        </div>

        <div>
          <label for="colorCollar">Color del collar</label>
          <input type="color" id="colorCollar" value="#e83e91">
        </div>

        <div>
          <label for="colorLetras">Color de las letras</label>
          <input type="color" id="colorLetras" value="#ffffff">
        </div>

        <div>
          <label for="colorTexto">Color del texto</label>
          <input type="color" id="colorTexto" value="#222222">
        </div>

        <div>
          <label for="tipo">Modelo de collar</label>
          <select id="tipo">
            <option value="normal">Collar clásico</option>
            <option value="paracord">Paracord</option>
            <option value="3d">Letras 3D</option>
            <option value="chunky">Chunky</option>
          </select>
        </div>

        <button onclick="copiarPedido()">Copiar diseño para enviar por WhatsApp</button>
      </div>
    </section>

    <p class="nota">
      Salchi & Co. — Collares que cuentan historias 💖
    </p>
  </main>

  <script>
    const nombre = document.getElementById("nombre");
    const colorCollar = document.getElementById("colorCollar");
    const colorLetras = document.getElementById("colorLetras");
    const colorTexto = document.getElementById("colorTexto");
    const tipo = document.getElementById("tipo");
    const collar = document.getElementById("collar");
    const resumen = document.getElementById("resumen");
    const tituloVista = document.getElementById("tituloVista");

    function actualizarCollar() {
      let texto = nombre.value.trim().toUpperCase();

      if (texto === "") {
        texto = "NOMBRE";
      }

      collar.innerHTML = "";

      for (let letra of texto) {
        const elemento = document.createElement("span");
        elemento.className = "letra";
        elemento.textContent = letra;
        elemento.style.background = colorLetras.value;
        elemento.style.color = colorTexto.value;

        if (tipo.value === "3d") {
          elemento.style.borderRadius = "12px";
          elemento.style.boxShadow = "4px 4px 0 #00000035";
        }

        if (tipo.value === "chunky") {
          elemento.style.borderRadius = "8px";
          elemento.style.fontSize = "28px";
        }

        collar.appendChild(elemento);
      }

      collar.style.background = colorCollar.value;

      if (tipo.value === "paracord") {
        collar.style.backgroundImage =
          "repeating-linear-gradient(45deg, transparent, transparent 8px, #ffffff35 8px, #ffffff35 12px)";
      } else {
        collar.style.backgroundImage = "none";
      }

      tituloVista.textContent = "Collar " + texto;
      resumen.textContent = "Nombre: " + texto;
    }

    function copiarPedido() {
      const texto =
        "Hola Salchi & Co. 🐾%0A" +
        "Quiero consultar por un collar personalizado.%0A" +
        "Nombre: " + nombre.value.toUpperCase() + "%0A" +
        "Color del collar: " + colorCollar.value + "%0A" +
        "Color de las letras: " + colorLetras.value + "%0A" +
        "Color del texto: " + colorTexto.value + "%0A" +
        "Modelo: " + tipo.value;

      window.open(
        "https://wa.me/543795110074?text=" + texto,
        "_blank"
      );
    }

    nombre.addEventListener("input", actualizarCollar);
    colorCollar.addEventListener("input", actualizarCollar);
    colorLetras.addEventListener("input", actualizarCollar);
    colorTexto.addEventListener("input", actualizarCollar);
    tipo.addEventListener("change", actualizarCollar);

    actualizarCollar();
  </script>
</body>
</html>
